# Copy to .env and adjust to point at staging. Every var has a hardcoded
# fallback in src/data/api.js, so the site works without this file.
#
# Vite only exposes VITE_-prefixed vars, and it inlines them into the JS
# bundle — anything here is readable by anyone who opens devtools. Public
# hostnames only. Never put an API key, token or secret in this file.

VITE_API_BASE_URL=https://api.rajivwilliams.com
VITE_BLOG_BASE_URL=https://blog.dprprop.com
VITE_BLOG_CLIENT_ID=6814779c33c366561f26aec9
VITE_STORAGE_DN_URL=https://dprstorage.b-cdn.net
# --- WhatsApp ----------------------------------------------------------------
VITE_WHATSAPP_SENDER_NUMBER=7997992886
VITE_WHATSAPP_SENDER_NAME="Rajiv Williams"
VITE_SUPPORT_CONTACT=9549546568

# Empty = proxy only. Filling this in publishes the key in the bundle.
VITE_AISENSY_API_KEY=